# 默认上游 Agent 接入点，全部群聊与私聊统一使用。
AGENT_API_URL=http://127.0.0.1:8642

# 全局上游 API 鉴权密钥。仅写在 .env，不写入任何 YAML、不回显到日志。
AGENT_API_KEY=''

# 默认 API 请求超时秒数（Agent 执行可能较慢）。
AGENT_API_TIMEOUT=300

# API 接口选择：completions / runs。取代旧 runs_channel_enabled 布尔键，
# 默认沿用现行缺省 completions；旧 True 映射为 runs。
AGENT_API_INTERFACE=completions

# 是否启动内嵌 MCP server，供上游反向调用消息、文件与推送工具。重启生效。
AGENT_MCP_ENABLED=false

# 内嵌 MCP server 监听地址。重启生效。
AGENT_MCP_HOST=127.0.0.1

# 内嵌 MCP server 监听端口。重启生效。
AGENT_MCP_PORT=8643

# 插件配置与记忆文件根目录；留空使用 localstore 默认目录。由旧 custom_dir
# 改名，是定位其他 YAML 的自举例外。
AGENT_PLUGIN_CUSTOM_DIR=''
